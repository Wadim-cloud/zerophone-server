# Caddyfile for ZeroPhone deployment
# Place this in /etc/caddy/Caddyfile and reload: sudo systemctl reload caddy

yourdomain.com {
    # TLS is automatic with Let's Encrypt
    reverse_proxy localhost:9443
}

