# Coturn handles TLS directly - no nginx needed
# Just open ports in firewall

# For coturn, use this simpler setup:
# 1. coturn listens on 3478 UDP (STUN)
# 2. coturn listens on 3479 TCP (TURN)  
# 3. coturn listens on 5349 TCP (TURN over TLS)

# Remove the nginx config:
sudo rm /etc/nginx/sites-enabled/turn

# And use coturn's built-in TLS