# ZeroPhone Environment Configuration
# Copy to .env and customize

# Server Configuration
ZEROPHONE_CLUSTER=1
ZEROPHONE_PORT=8081

# ZeroTier Network (set your actual values)
ZEROTIER_IP=
ZEROTIER_NETWORK=your_network_id

# Data Directory
ZEROPHONE_DATA=/data

# Peers (comma-separated, e.g., "10.121.15.208:8080,10.121.15.223:8080")
ZEROPHONE_PEERS=

# Docker-specific (used in docker-compose.yml)
HTTP_PORT=8080
ZMQ_ROUTER_PORT=5555
ZMQ_PUB_PORT=5556
ZMQ_DISCOVERY_PORT=5557
ZMQ_ASYNC_PORT=5558
